{
  "name": "flits-video",
  "version": "0.2.0",
  "description": "Write flits videos in TypeScript: components, motion helpers and types for the scene format, plus a wrapper around the flits CLI",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./scene": {
      "types": "./scene.d.ts"
    },
    "./components": {
      "types": "./components.d.ts",
      "default": "./components.js"
    },
    "./motion": {
      "types": "./motion.d.ts",
      "default": "./motion.js"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "default": "./jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-dev-runtime.d.ts",
      "default": "./jsx-dev-runtime.js"
    }
  },
  "files": ["index.js", "index.d.ts", "scene.d.ts", "compile.js", "compile.d.ts", "components.js", "components.d.ts", "motion.js", "motion.d.ts", "jsx-runtime.js", "jsx-runtime.d.ts", "jsx-dev-runtime.js", "jsx-dev-runtime.d.ts"],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArjandenHartog/flits",
    "directory": "bindings/typescript"
  },
  "keywords": ["flits", "video", "rendering", "json", "scene"]
}
